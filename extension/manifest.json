{
  "manifest_version": 3,
  "name": "BreadBoard Side Panel",
  "version": "0.0.0",
  "description": "Follow video tutorials in the web software they teach.",
  "permissions": ["activeTab", "sidePanel", "scripting", "storage"],
  "host_permissions": [
    "https://photopea.com/*",
    "https://www.photopea.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://www.figma.com/*",
    "https://www.canva.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open BreadBoard side panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://photopea.com/*",
        "https://www.photopea.com/*",
        "https://www.figma.com/*",
        "https://www.canva.com/*"
      ],
      "js": ["workspace.js"]
    },
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["dashboard-bridge.js"]
    }
  ],
  "externally_connectable": {
    "matches": ["http://localhost/*", "http://127.0.0.1/*"]
  }
}
