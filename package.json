{
  "name": "breadboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Context-aware Photopea learning companion",
  "workspaces": [
    "shared",
    "server",
    "extension"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace @breadboard/server",
    "dev:extension": "npm run dev --workspace @breadboard/extension",
    "dev:sandbox": "vite --config sandbox/vite.config.ts",
    "build": "npm run build --workspace @breadboard/shared && npm run build --workspace @breadboard/server && npm run build --workspace @breadboard/extension && npm run build:sandbox",
    "build:sandbox": "vite build --config sandbox/vite.config.ts",
    "start": "npm run start --workspace @breadboard/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p sandbox/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node scripts/smoke.mjs",
    "mock": "npm run dev --workspace @breadboard/server -- --mock",
    "demo": "npm run build && node server/dist/index.js --mock",
    "live": "npm run build && node server/dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/chrome": "^0.0.290",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
